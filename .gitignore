# ขึ้น repo เฉพาะของที่ user ต้องใช้ติดตั้ง skill — อย่างอื่นที่ root ถูกกันไว้ทั้งหมด
# (ข้อมูลที่ดึงมา, สำเนา skill ใน .claude/ .agents/, ไฟล์ทดลอง ฯลฯ)
# จะเพิ่มของใหม่ที่ root ขึ้น repo ต้องเพิ่มบรรทัด !/ชื่อ ที่นี่
/*
!/.gitignore
!/package.json
!/README.md
!/bin/
!/skills/

# ข้อมูลที่ใช้เรียนรู้/ทดสอบ skill — ไม่ขึ้น repo แม้จะอยู่ใต้ skills/
/skills/*-workspace/
/skills/*/evals/
/skills/*/tests/
/skills/*/testdata/
/skills/*/samples/

node_modules/
.env
